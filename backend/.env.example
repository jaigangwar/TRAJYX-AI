# ============================================================================
# TRAJYX backend configuration
# ----------------------------------------------------------------------------
# Copy to backend/.env and adjust. Never commit the real .env file.
# All variables are prefixed TRAJYX_ and map to backend/app/core/config.py.
#
# The stack runs with NO cloud credentials at all: leave the Firebase block
# empty and the backend resolves to the local on-disk store, local auth and
# local file storage. Every degraded adapter is reported on GET /api/v1/health.
# ============================================================================

# ---------------------------------------------------------------- service ----
TRAJYX_ENVIRONMENT=development          # development | staging | production | test
TRAJYX_HOST=127.0.0.1
TRAJYX_PORT=8000
TRAJYX_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
TRAJYX_LOG_JSON=false                   # true in staging/production

# Comma-separated browser origins allowed to call the API.
TRAJYX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- adapters ----
# auto = use Firebase when credentials are present, otherwise local.
TRAJYX_DATA_BACKEND=auto                # auto | firestore | local
TRAJYX_AUTH_BACKEND=auto                # auto | firebase   | local
TRAJYX_STORAGE_BACKEND=auto             # auto | firebase   | local

# --------------------------------------------------------------- firebase ----
# Leave blank to run fully locally. See docs/firebase-setup.md.
TRAJYX_FIREBASE_PROJECT_ID=
TRAJYX_FIREBASE_CREDENTIALS_PATH=       # e.g. firebase/service-account.json (gitignored)
TRAJYX_FIREBASE_CREDENTIALS_JSON=       # raw JSON alternative, for env-only platforms
TRAJYX_FIREBASE_STORAGE_BUCKET=         # e.g. your-project.appspot.com

# --------------------------------------------------- local adapter storage ----
TRAJYX_LOCAL_DATA_DIR=data/store
TRAJYX_LOCAL_STORAGE_DIR=data/storage

# --------------------------------------------------------------- security ----
# Signs locally issued development tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup FAILS in production if this is left at the default.
TRAJYX_JWT_SECRET=dev-only-insecure-secret-change-me
TRAJYX_ACCESS_TOKEN_TTL_MINUTES=720

# ---------------------------------------------------------------- uploads ----
TRAJYX_MAX_UPLOAD_BYTES=536870912       # 512 MiB
TRAJYX_ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

# ------------------------------------------------------------- processing ----
TRAJYX_WORKER_CONCURRENCY=1             # raise only with GPU capacity
TRAJYX_FRAME_STRIDE=2                   # process every Nth frame

# ------------------------------------------------------------------- demo ----
# Exposes simulation endpoints and seeded synthetic records.
# Synthetic records always carry origin=DEMO and are labeled in both clients.
TRAJYX_DEMO_MODE=true

# -------------------------------------------------------------- retention ----
TRAJYX_RETENTION_DAYS_DETECTIONS=30
TRAJYX_RETENTION_DAYS_EVENTS=365
