# ============================================================================
# TRAJYX web dashboard configuration
# ----------------------------------------------------------------------------
# Copy to web/.env and adjust. Vite only exposes variables prefixed VITE_.
#
# Anything here ships to the browser. Never put a service-account key, an API
# secret or a private token in this file — Firebase *web* config values are
# public by design and are safe; service-account credentials are not.
# ============================================================================

# Base URL of the TRAJYX API (no trailing slash) and its version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# ---------------------------------------------------------------------- maps --
# MapLibre-compatible style. The bundled default needs no account or key, so
# the risk map renders on a clean checkout. Replace with a vector style for
# production cartography.
VITE_MAP_STYLE_URL=/map-styles/trajyx-dark.json

# Optional. Only needed if you point VITE_MAP_STYLE_URL at a Mapbox style.
VITE_MAPBOX_TOKEN=

# ------------------------------------------------------------------ firebase --
# Leave blank to use the backend's local development auth. Fill in from
# Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
